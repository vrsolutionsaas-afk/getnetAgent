# ==== OpenAI ====
# Chave da API da OpenAI (obrigatoria)
OPENAI_API_KEY=sk-sua-chave-aqui

# ==== Tavily (web search) ====
# Chave gratuita em https://tavily.com
TAVILY_API_KEY=tvly-sua-chave-aqui

# ==== Banco de dados (pgvector) ====
# No docker-compose o host e' o nome do servico "db"
POSTGRES_USER=getnet
POSTGRES_PASSWORD=getnet
POSTGRES_DB=getnet_rag
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==== Modelos ====
MODELO_ROTEAMENTO=gpt-4o-mini
MODELO_GERACAO=gpt-4o
MODELO_EMBEDDING=text-embedding-3-small

# ==== RAG ====
# Limiar minimo de similaridade (0-1) para usar o contexto recuperado
RAG_LIMIAR_SIMILARIDADE=0.5
# Numero de trechos recuperados por consulta
RAG_TOP_K=4

# ==== App ====
LOG_LEVEL=INFO
